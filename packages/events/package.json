{
  "name": "@adili/events",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@adili/api-kit": "workspace:*",
    "@adili/data-access": "workspace:*",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "drizzle-orm": "^0.45.3",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@adili/eslint-config": "workspace:*",
    "@adili/tsconfig": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/microservices": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/testing": "^12.1.0",
    "@swc/core": "^1.16.2",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/microservices": "^12.1.0",
    "rxjs": "^7.8.2"
  }
}
