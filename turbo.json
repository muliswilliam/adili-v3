{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "eval": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["GITHUB_STEP_SUMMARY"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "TEST_DATABASE_URL",
        "TEST_RABBITMQ_URL",
        "TEST_OPENBAO_URL",
        "TEST_OPENBAO_TOKEN",
        "TEST_TEMPORAL_ADDRESS",
        "TEST_TEMPORAL_NAMESPACE",
        "TEST_VALKEY_URL",
        "TEST_KEYCLOAK_ISSUER_URL",
        "TEST_MAILPIT_URL",
        "TEST_S3_ENDPOINT",
        "TEST_CLAMAV_HOST",
        "TEST_CLAMAV_PORT"
      ]
    },
    "db:generate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:migrate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["db:migrate"],
      "cache": false
    }
  }
}
