{
  "name": "adili-v3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bootstrap": "node scripts/setup-env.mjs && pnpm install",
    "infra:up": "./scripts/infra-up.sh",
    "infra:down": "./scripts/infra-down.sh",
    "infra:reset": "./scripts/infra-down.sh --volumes",
    "infra:logs": "./scripts/infra-logs.sh",
    "infra:health": "./scripts/infra-health.sh",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "dev": "turbo run dev --concurrency=64",
    "dev:services": "turbo run dev --concurrency=64 --filter='./services/*'",
    "dev:apps": "turbo run dev --concurrency=64 --filter='./apps/*'",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "eval": "turbo run eval",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise services packages apps --config .dependency-cruiser.cjs",
    "contracts": "turbo run build --filter='./services/*^...' --output-logs=errors-only && pnpm --filter './services/*' --if-present contracts",
    "contracts:lint": "pnpm --filter @adili/schemas lint:openapi && pnpm --filter @adili/schemas lint:forms",
    "contracts:drift": "turbo run build --filter='./services/*^...' --output-logs=errors-only && pnpm --filter @adili/schemas check:drift",
    "check": "pnpm format:check && pnpm contracts:lint && pnpm contracts:drift && turbo run lint typecheck test && pnpm deps:check",
    "health": "node scripts/health.mjs",
    "keycloak:check": "node scripts/check-keycloak-realm.mjs",
    "keycloak:demo-sign-in": "node scripts/keycloak-demo-sign-in.mjs",
    "demo:seed": "pnpm --filter @adili/demo-seed seed"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.4.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "~6.0.3"
  }
}
