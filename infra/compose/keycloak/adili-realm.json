{
  "id": "adili",
  "realm": "adili",
  "displayName": "Adili Online",
  "enabled": true,
  "loginTheme": "adili",
  "emailTheme": "adili",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@adili.go.ke",
    "fromDisplayName": "Adili Online"
  },
  "browserFlow": "adili browser",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "webAuthnPolicyRpEntityName": "Adili Online",
  "webAuthnPolicySignatureAlgorithms": ["ES256", "RS256"],
  "webAuthnPolicyAttestationConveyancePreference": "not specified",
  "webAuthnPolicyAuthenticatorAttachment": "not specified",
  "webAuthnPolicyRequireResidentKey": "not specified",
  "webAuthnPolicyUserVerificationRequirement": "preferred",
  "attributes": {
    "acr.loa.map": "{\"step-up\":2}"
  },
  "roles": {
    "realm": [
      {
        "name": "declarant",
        "description": "Public officer filing declarations"
      },
      {
        "name": "reporting-officer",
        "description": "Commission reporting officer: roster import and onboarding support"
      },
      {
        "name": "reviewer",
        "description": "Commission reviewer"
      },
      {
        "name": "supervisor",
        "description": "Commission supervisor / approver"
      },
      {
        "name": "commission-admin",
        "description": "Commission administrator"
      },
      {
        "name": "access-officer",
        "description": "Decides Form K and law enforcement requests"
      },
      {
        "name": "eacc-analyst",
        "description": "EACC analyst"
      },
      {
        "name": "eacc-supervisor",
        "description": "EACC supervisor"
      },
      {
        "name": "auditor",
        "description": "Reads the audit trail"
      },
      {
        "name": "helpdesk",
        "description": "Account support"
      },
      {
        "name": "platform-admin",
        "description": "Operates the platform"
      },
      {
        "name": "applicant",
        "description": "Public Form K applicant"
      },
      {
        "name": "law-enforcement",
        "description": "Institution-issued law enforcement account"
      }
    ]
  },
  "clients": [
    {
      "clientId": "portal",
      "name": "Adili portal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "portal-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3010/*"],
      "webOrigins": ["http://localhost:3010"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3010/*",
        "default.acr.values": "step-up"
      },
      "defaultClientScopes": ["web-origins", "acr", "basic", "profile", "email", "roles"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "adili-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "adili-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "console",
      "name": "Adili console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "console-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3020/*"],
      "webOrigins": ["http://localhost:3020"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3020/*",
        "default.acr.values": "step-up"
      },
      "defaultClientScopes": ["web-origins", "acr", "basic", "profile", "email", "roles"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
