  "authenticatorConfig": [
    {
      "alias": "adili-loa-1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "adili-loa-2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "300"
      }
    },
    {
      "alias": "adili-role-declarant",
      "config": {
        "condUserRole": "declarant",
        "negate": "false"
      }
    },
    {
      "alias": "adili-role-applicant",
      "config": {
        "condUserRole": "applicant",
        "negate": "false"
      }
    },
    {
      "alias": "adili-role-not-declarant",
      "config": {
        "condUserRole": "declarant",
        "negate": "true"
      }
    },
    {
      "alias": "adili-role-not-applicant",
      "config": {
        "condUserRole": "applicant",
        "negate": "true"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "adili browser",
      "description": "Browser login: password at LoA 1, OTP at LoA 2 for step-up",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "authenticator": "identity-provider-redirector"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "autheticatorFlow": true,
          "flowAlias": "adili browser forms"
        }
      ]
    },
    {
      "alias": "adili browser forms",
      "description": "Username/password then role-specific OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "autheticatorFlow": true,
          "flowAlias": "adili password"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "autheticatorFlow": true,
          "flowAlias": "adili otp"
        }
      ]
    },
    {
      "alias": "adili password",
      "description": "Password form at LoA 1; remains valid for the SSO session",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "adili-loa-1"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "authenticator": "auth-username-password-form"
        }
      ]
    },
    {
      "alias": "adili otp",
      "description": "LoA 2 OTP. Step-up with acr_values=step-up re-runs only this (max age 300s)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "adili-loa-2"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "autheticatorFlow": true,
          "flowAlias": "adili declarant otp"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "autheticatorFlow": true,
          "flowAlias": "adili applicant otp"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 40,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "autheticatorFlow": true,
          "flowAlias": "adili staff totp"
        }
      ]
    },
    {
      "alias": "adili declarant otp",
      "description": "Declarant SMS/email OTP. #79 adds REQUIRED authenticator adili-otp here",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "adili-role-declarant"
        }
      ]
    },
    {
      "alias": "adili applicant otp",
      "description": "Applicant SMS/email OTP. #79 adds REQUIRED authenticator adili-otp here",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "adili-role-applicant"
        }
      ]
    },
    {
      "alias": "adili staff totp",
      "description": "Staff and law-enforcement TOTP (anyone who is not a declarant or applicant)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "adili-role-not-declarant"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "adili-role-not-applicant"
        },
        {
          "requirement": "REQUIRED",
          "priority": 30,
          "userSetupAllowed": true,
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form"
        }
      ]
    }
  ],
