[Unit]
Description=Adili demo: services and mocks (turbo dev), portal, console and verify (production builds)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adili
Group=adili
WorkingDirectory=/opt/adili
Environment=HOME=/home/adili
Environment=PATH=/usr/bin:/usr/local/bin:/home/adili/.local/bin:/home/adili/.local/share/pnpm
Environment=ADILI_DEMO_BIND=1
EnvironmentFile=/etc/adili/public.env
# Restores a demo checkpoint first when `pnpm demo:reset` asked for one (#621); never fails.
ExecStartPre=/opt/adili/infra/azure/demo-pending-reset.sh
# Services and mocks run as `pnpm dev`; the apps from their production builds (run-apps.sh, #371).
ExecStart=/opt/adili/infra/azure/run-apps.sh
Restart=on-failure
RestartSec=5
# Covers a checkpoint restore in ExecStartPre (about a minute).
TimeoutStartSec=420

[Install]
WantedBy=multi-user.target
