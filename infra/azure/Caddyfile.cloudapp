{
  email __EMAIL__
}

http://__HOST__ {
  redir https://__HOST__{uri} permanent
}

https://__HOST__ {
  reverse_proxy 127.0.0.1:13010
}

https://__HOST__:3010 {
  redir https://__HOST__{uri} permanent
}

https://__HOST__:3020 {
  reverse_proxy 127.0.0.1:13020
}

https://__HOST__:3030 {
  reverse_proxy 127.0.0.1:13030
}

# Keycloak: only what sign-in needs, the adili realm and the theme's resources. The admin
# console, the admin API and the master realm stay on loopback (127.0.0.1:18080).
https://__HOST__:8080 {
  @signin path /realms/adili /realms/adili/* /resources/*
  handle @signin {
    reverse_proxy 127.0.0.1:18080
  }
  handle {
    respond 404
  }
}
