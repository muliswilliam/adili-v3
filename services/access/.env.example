# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
PORT=4004
LOG_LEVEL=debug
OIDC_ISSUER_URL=http://localhost:8080/realms/adili
DATABASE_URL=postgres://adili_access:adili_access_dev@localhost:55432/adili_access
RABBITMQ_URL=amqp://adili:adili_dev@localhost:55672
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=adili
TEMPORAL_TASK_QUEUE=access
DIRECTORY_URL=http://localhost:4001
DECLARATIONS_URL=http://localhost:4002
DOCUMENTS_URL=http://localhost:4006
NOTIFICATIONS_URL=http://localhost:4010
REVIEW_URL=http://localhost:4003
PORTAL_URL=http://localhost:3010
CONSOLE_URL=http://localhost:3020
KEYCLOAK_CLIENT_ID=access
KEYCLOAK_CLIENT_SECRET=access-dev-secret
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=adili-dev-root-token
SELF_ACCESS_DAYS=14
OTEL_SERVICE_NAME=access
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Demo stack only (#371): grant documents stay in force this long (ISO-8601 duration) instead of
# their download window, so a demo can show an expired document. Refused unless DEMO_MODE=true.
# DEMO_MODE=true
# DEMO_PACKAGE_VALIDITY=PT2M
