# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
PORT=4006
LOG_LEVEL=debug
OIDC_ISSUER_URL=http://localhost:8080/realms/adili
DATABASE_URL=postgres://adili_documents:adili_documents_dev@localhost:55432/adili_documents
RABBITMQ_URL=amqp://adili:adili_dev@localhost:55672
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=adili
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=adili-dev-access
S3_SECRET_ACCESS_KEY=adili-dev-secret
S3_BUCKET_QUARANTINE=quarantine
S3_BUCKET_CLEAN=clean
S3_BUCKET_ISSUED=issued
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
GOTENBERG_URL=http://localhost:3300
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=adili-dev-root-token
OTEL_SERVICE_NAME=documents
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
