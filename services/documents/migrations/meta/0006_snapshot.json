      "checkConstraints": {
        "uploads_state_check": {
          "name": "uploads_state_check",
          "value": "\"uploads\".\"state\" in ('awaiting-upload', 'clean', 'infected', 'rejected', 'expired', 'deleted')"
        },
        "uploads_rejection_check": {
          "name": "uploads_rejection_check",
          "value": "(\"uploads\".\"state\" = 'rejected') = (\"uploads\".\"rejection\" is not null) and (\"uploads\".\"rejection\" is null or \"uploads\".\"rejection\" in ('type', 'encoding', 'size', 'missing', 'timeout'))"
        },
        "uploads_clean_check": {
          "name": "uploads_clean_check",
          "value": "(\"uploads\".\"state\" = 'clean') = (\"uploads\".\"sha256\" is not null and \"uploads\".\"clean_key\" is not null and \"uploads\".\"size\" is not null and \"uploads\".\"detected_type\" is not null)"
        },
        "uploads_completed_at_check": {
          "name": "uploads_completed_at_check",
          "value": "(\"uploads\".\"state\" in ('clean', 'infected', 'rejected', 'deleted')) = (\"uploads\".\"completed_at\" is not null)"
        },
        "uploads_deleted_at_check": {
          "name": "uploads_deleted_at_check",
          "value": "(\"uploads\".\"state\" = 'deleted') = (\"uploads\".\"deleted_at\" is not null)"
        },
        "uploads_linked_at_check": {
          "name": "uploads_linked_at_check",
          "value": "\"uploads\".\"linked_at\" is null or \"uploads\".\"state\" = 'clean'"
        },
        "uploads_linked_by_check": {
          "name": "uploads_linked_by_check",
          "value": "(\"uploads\".\"linked_at\" is null) = (\"uploads\".\"linked_by\" is null)"
        },
        "uploads_declared_size_check": {
          "name": "uploads_declared_size_check",
          "value": "\"uploads\".\"declared_size\" > 0"
        }
      },
