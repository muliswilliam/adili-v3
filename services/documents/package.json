{
  "name": "@adili/documents",
  "version": "0.0.0",
  "private": true,
  "description": "Uploads, malware scanning, PDF issuance, signing, QR codes and verification records.",
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "generate:api": "openapi-typescript node_modules/@adili/schemas/internal/declarations.yaml -o src/declarations/declarations-api.gen.ts",
    "build": "pnpm generate:api && tsc -p tsconfig.build.json",
    "dev": "node --disable-warning=DEP0205 --env-file-if-exists=.env --import @swc-node/register/esm-register --watch-path=src --watch-preserve-output src/main.ts",
    "start": "node --import @adili/telemetry/register dist/main.js",
    "lint": "eslint .",
    "typecheck": "pnpm generate:api && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=DEP0205 --env-file-if-exists=.env --import @swc-node/register/esm-register src/db/migrate.ts",
    "contracts": "node --disable-warning=DEP0205 --env-file=.env.example --import @swc-node/register/esm-register ../../packages/schemas/scripts/export-contract.mjs"
  },
  "dependencies": {
    "@adili/api-kit": "workspace:*",
    "@adili/data-access": "workspace:*",
    "@adili/events": "workspace:*",
    "@adili/numbering": "workspace:*",
    "@adili/roles": "workspace:*",
    "@adili/telemetry": "workspace:*",
    "@adili/temporal": "workspace:*",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/microservices": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@signpdf/utils": "^3.3.0",
    "asn1js": "^3.0.10",
    "drizzle-orm": "^0.45.3",
    "pdf-lib": "^1.17.1",
    "pkijs": "^3.4.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@adili/eslint-config": "workspace:*",
    "@adili/schemas": "workspace:*",
    "@adili/tsconfig": "workspace:*",
    "@adili/vitest-config": "workspace:*",
    "@napi-rs/canvas": "^1.0.9",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/testing": "^12.1.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "amqplib": "^2.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "jose": "^6.2.12",
    "jsqr": "^1.4.0",
    "openapi-typescript": "^7.13.0",
    "pdfjs-dist": "^6.3.289",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
