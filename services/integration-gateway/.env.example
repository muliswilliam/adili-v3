# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
PORT=4009
LOG_LEVEL=debug
OIDC_ISSUER_URL=http://localhost:8080/realms/adili
DATABASE_URL=postgres://adili_integration_gateway:adili_integration_gateway_dev@localhost:55432/adili_integration_gateway
RABBITMQ_URL=amqp://adili:adili_dev@localhost:55672
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=adili
VALKEY_URL=redis://localhost:56379
MOCKS_BASE_URL=http://localhost:8000
IPRS_BASE_URL=http://localhost:8000/iprs
IPRS_TIMEOUT_MS=2000
IPRS_CACHE_TTL_SECONDS=86400
IPRS_RATE_LIMIT_PER_MINUTE=1200
KRA_BASE_URL=http://localhost:8000/kra
NTSA_BASE_URL=http://localhost:8000/ntsa
BRS_BASE_URL=http://localhost:8000/brs
ARDHISASA_BASE_URL=http://localhost:8000/ardhisasa
HR_BASE_URL=http://localhost:8000/hr
# Registry rate limits are calls a minute, at the mocks' own limit (MOCK_REGISTRY_RATE_LIMIT, 60
# calls a minute each). Every call takes a slot: a KRA lookup makes 1 + one per PIN (the PINs,
# then each PIN's compliance). A lookup reserves its usual calls together before its timeout
# starts, waiting up to RATE_LIMIT_MAX_WAIT_MS; one second's worth of calls may burst, and KRA at
# least four, so a declarant's lookup then a spouse's (two calls each, one after the other) never
# queue; a third person's may, or be answered rate-limited and retried.
KRA_TIMEOUT_MS=2000
KRA_CACHE_TTL_SECONDS=86400
KRA_RATE_LIMIT_PER_MINUTE=60
NTSA_TIMEOUT_MS=2000
NTSA_CACHE_TTL_SECONDS=86400
NTSA_RATE_LIMIT_PER_MINUTE=60
BRS_TIMEOUT_MS=2000
BRS_CACHE_TTL_SECONDS=86400
BRS_RATE_LIMIT_PER_MINUTE=60
ARDHISASA_TIMEOUT_MS=2000
ARDHISASA_CACHE_TTL_SECONDS=86400
ARDHISASA_RATE_LIMIT_PER_MINUTE=60
HR_SUPPLIERS_TIMEOUT_MS=2000
HR_SUPPLIERS_CACHE_TTL_SECONDS=86400
HR_SUPPLIERS_RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_MAX_WAIT_MS=1000
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_MS=30000
SUBJECT_HASH_KEY=local-dev-subject-hash-key-not-a-secret
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=adili-dev-root-token
OTEL_SERVICE_NAME=integration-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
