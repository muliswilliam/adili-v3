# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
PORT=4009
LOG_LEVEL=debug
OIDC_ISSUER_URL=http://localhost:8080/realms/adili
DATABASE_URL=postgres://adili_integration_gateway:adili_integration_gateway_dev@localhost:55432/adili_integration_gateway
RABBITMQ_URL=amqp://adili:adili_dev@localhost:55672
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=adili
VALKEY_URL=redis://localhost:56379
MOCKS_BASE_URL=http://localhost:8000
IPRS_BASE_URL=http://localhost:8000/iprs
IPRS_TIMEOUT_MS=2000
IPRS_CACHE_TTL_SECONDS=86400
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_MS=30000
SUBJECT_HASH_KEY=local-dev-subject-hash-key-not-a-secret
OTEL_SERVICE_NAME=integration-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
