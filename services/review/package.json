{
  "name": "@adili/review",
  "version": "0.0.0",
  "private": true,
  "description": "Review cases, risk flags, clarifications, determinations, administrative actions and referrals.",
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --disable-warning=DEP0205 --env-file-if-exists=.env --import @swc-node/register/esm-register --watch-path=src --watch-preserve-output src/main.ts",
    "start": "node --import @adili/telemetry/register dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=DEP0205 --env-file-if-exists=.env --import @swc-node/register/esm-register src/db/migrate.ts"
  },
  "dependencies": {
    "@adili/api-kit": "workspace:*",
    "@adili/data-access": "workspace:*",
    "@adili/events": "workspace:*",
    "@adili/telemetry": "workspace:*",
    "@adili/temporal": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/microservices": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "drizzle-orm": "^0.45.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@adili/eslint-config": "workspace:*",
    "@adili/tsconfig": "workspace:*",
    "@nestjs/testing": "^12.1.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  }
}
