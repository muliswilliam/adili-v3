# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
PORT=4003
LOG_LEVEL=debug
OIDC_ISSUER_URL=http://localhost:8080/realms/adili
DATABASE_URL=postgres://adili_review:adili_review_dev@localhost:55432/adili_review
RABBITMQ_URL=amqp://adili:adili_dev@localhost:55672
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=adili
TEMPORAL_TASK_QUEUE=review
DECLARATIONS_URL=http://localhost:4002
DIRECTORY_URL=http://localhost:4001
DOCUMENTS_URL=http://localhost:4006
NOTIFICATIONS_URL=http://localhost:4010
INTEGRATION_GATEWAY_URL=http://localhost:4009
AI_GATEWAY_URL=http://localhost:4008
# Commissions whose declarations are synthetic demo data: the copilot sends them to the ai-gateway as
# `synthetic`, every other Commission's as `highly-confidential` (blocked from external providers).
AI_SYNTHETIC_DATA_TENANTS=psc
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=adili-dev-root-token
PORTAL_URL=http://localhost:3010
KEYCLOAK_CLIENT_ID=review
KEYCLOAK_CLIENT_SECRET=review-dev-secret
OTEL_SERVICE_NAME=review
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Demo stack only (#371): shortened windows (ISO-8601 durations) for windows started while set,
# so a demo can seed a clarification past its reply window or a ladder past its notice. Refused
# unless DEMO_MODE=true, and always in production.
# DEMO_MODE=true
# DEMO_CLARIFICATION_REPLY_WINDOW=PT2M
# DEMO_LADDER_NOTICE_WINDOW=PT1M
# DEMO_LADDER_WARNING_WINDOW=PT1M
# DEMO_LADDER_STOPPAGE_WINDOW=PT1M
