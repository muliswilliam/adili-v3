# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
PORT=4008
LOG_LEVEL=debug
OIDC_ISSUER_URL=http://localhost:8080/realms/adili
DATABASE_URL=postgres://adili_ai_gateway:adili_ai_gateway_dev@localhost:55432/adili_ai_gateway
RABBITMQ_URL=amqp://adili:adili_dev@localhost:55672
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=adili
AI_TASK_QUEUE=ai
# replay serves recorded fixtures; anthropic calls the API (AI_PROVIDER is required in production).
# AI_REPLAY_MODE=record refreshes fixtures from Anthropic and writes the full prompts into them;
# fixtures are committed, so record synthetic inputs only. Refused in production.
AI_PROVIDER=replay
AI_REPLAY_MODE=replay
AI_FIXTURES_DIR=fixtures/ai
# normalised ignores the ids and timestamps a fresh run of the same demo beat mints anew, so a
# recorded demo replays (`pnpm demo:ai replay`, docs/demo/README.md). exact for tests and evals.
# AI_REPLAY_MATCH=exact
# Model every task uses until the routing table lands.
AI_MODEL=claude-opus-5-5
# Hours a finished job keeps its output (the calling service stores what it shows).
AI_OUTPUT_RETENTION_HOURS=24
# Where the download links of documents a task reads may point (the documents store, S3_ENDPOINT).
AI_DOCUMENT_ORIGINS=http://localhost:8333
# Transit keys that seal reviewers' feedback notes under the tenant's key (ADR-006).
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=adili-dev-root-token
# Required for AI_PROVIDER=anthropic or AI_REPLAY_MODE=record. Never commit a real key.
# ANTHROPIC_API_KEY=
# An Anthropic-compatible gateway instead of the API, and, if it drops `output_config`, prompted
# structured output (the schema goes into the system prompt).
# ANTHROPIC_BASE_URL=
# ANTHROPIC_STRUCTURED_OUTPUT=native
OTEL_SERVICE_NAME=ai-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
