{
  "name": "@adili/ai-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "AI task API with provider adapters, data-classification gate, prompt versions and budgets.",
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "prompts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --disable-warning=DEP0205 --env-file-if-exists=.env --import @adili/telemetry/register --import @swc-node/register/esm-register --watch-path=src --watch-preserve-output src/main.ts",
    "start": "node --import @adili/telemetry/register dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=DEP0205 --env-file-if-exists=.env --import @swc-node/register/esm-register src/db/migrate.ts",
    "db:seed": "node --disable-warning=DEP0205 --env-file-if-exists=.env --import @swc-node/register/esm-register src/db/seed.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval": "vitest run --config vitest.eval.config.ts",
    "eval:record": "AI_REPLAY_MODE=record vitest run --config vitest.eval.config.ts",
    "eval:prune": "node --disable-warning=DEP0205 --import @swc-node/register/esm-register evals/prune.ts",
    "eval:documents": "node --disable-warning=DEP0205 --import @swc-node/register/esm-register evals/documents/generate.ts",
    "contracts": "node --disable-warning=DEP0205 --env-file=.env.example --import @swc-node/register/esm-register ../../packages/schemas/scripts/export-contract.mjs"
  },
  "dependencies": {
    "@adili/api-kit": "workspace:*",
    "@adili/data-access": "workspace:*",
    "@adili/events": "workspace:*",
    "@adili/forms": "workspace:*",
    "@adili/roles": "workspace:*",
    "@adili/telemetry": "workspace:*",
    "@adili/temporal": "workspace:*",
    "@anthropic-ai/sdk": "^0.128.0",
    "@napi-rs/canvas": "^1.0.9",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/microservices": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "drizzle-orm": "^0.45.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@adili/eslint-config": "workspace:*",
    "@adili/schemas": "workspace:*",
    "@adili/tsconfig": "workspace:*",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/testing": "^12.1.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@temporalio/testing": "^1.24.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
