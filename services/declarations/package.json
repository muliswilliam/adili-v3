{
  "name": "@adili/declarations",
  "version": "0.0.0",
  "private": true,
  "description": "Filing obligations, drafts, declarations, versions, household and financial statements.",
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "corpus"
  ],
  "scripts": {
    "generate:api": "openapi-typescript node_modules/@adili/schemas/internal/directory.yaml -o src/directory/directory-api.gen.ts && openapi-typescript node_modules/@adili/schemas/internal/notifications.yaml -o src/notifications/notifications-api.gen.ts && openapi-typescript node_modules/@adili/schemas/internal/documents.yaml -o src/documents/documents-api.gen.ts && openapi-typescript node_modules/@adili/schemas/internal/integration-gateway.yaml -o src/integration-gateway/integration-gateway-api.gen.ts && openapi-typescript node_modules/@adili/schemas/internal/ai-gateway.yaml -o src/ai-gateway/ai-gateway-api.gen.ts",
    "build": "pnpm generate:api && tsc -p tsconfig.build.json",
    "dev": "node --disable-warning=DEP0205 --env-file-if-exists=.env --import @swc-node/register/esm-register --watch-path=src --watch-preserve-output src/main.ts",
    "start": "node --import @adili/telemetry/register dist/main.js",
    "lint": "eslint .",
    "typecheck": "pnpm generate:api && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=DEP0205 --env-file-if-exists=.env --import @swc-node/register/esm-register src/db/migrate.ts",
    "demo:open-cycle": "node --disable-warning=DEP0205 --env-file-if-exists=.env --import @swc-node/register/esm-register src/db/demo-open-cycle.ts",
    "contracts": "node --disable-warning=DEP0205 --env-file=.env.example --import @swc-node/register/esm-register ../../packages/schemas/scripts/export-contract.mjs"
  },
  "dependencies": {
    "@adili/api-kit": "workspace:*",
    "@adili/cache": "workspace:*",
    "@adili/data-access": "workspace:*",
    "@adili/events": "workspace:*",
    "@adili/forms": "workspace:*",
    "@adili/numbering": "workspace:*",
    "@adili/roles": "workspace:*",
    "@adili/telemetry": "workspace:*",
    "@adili/temporal": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/microservices": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "drizzle-orm": "^0.45.3",
    "openapi-fetch": "^0.17.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@adili/eslint-config": "workspace:*",
    "@adili/schemas": "workspace:*",
    "@adili/tsconfig": "workspace:*",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/testing": "^12.1.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@temporalio/testing": "^1.24.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "amqplib": "^2.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "jose": "^6.2.12",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
