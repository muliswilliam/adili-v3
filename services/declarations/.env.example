# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
PORT=4002
LOG_LEVEL=debug
OIDC_ISSUER_URL=http://localhost:8080/realms/adili
DATABASE_URL=postgres://adili_declarations:adili_declarations_dev@localhost:55432/adili_declarations
RABBITMQ_URL=amqp://adili:adili_dev@localhost:55672
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=adili
VALKEY_URL=redis://localhost:56379
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=adili-dev-root-token
OTEL_SERVICE_NAME=declarations
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
