# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
PORT=4010
LOG_LEVEL=debug
OIDC_ISSUER_URL=http://localhost:8080/realms/adili
DATABASE_URL=postgres://adili_notifications:adili_notifications_dev@localhost:55432/adili_notifications
RABBITMQ_URL=amqp://adili:adili_dev@localhost:55672
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=adili
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Adili Online <no-reply@adili.go.ke>
SMTP_REQUIRE_TLS=false
SMS_GATEWAY_URL=http://localhost:8000/sms
SMS_SENDER_ID=ADILI
RECIPIENT_HASH_KEY=local-dev-recipient-hash-key-not-a-secret
PROVIDER_TIMEOUT_MS=4000
OTEL_SERVICE_NAME=notifications
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
