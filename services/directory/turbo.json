{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/mocks/demo/rosters/*.csv"]
    },
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/schemas/internal/documents.yaml",
        "$TURBO_ROOT$/packages/schemas/internal/notifications.yaml"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/schemas/internal/documents.yaml",
        "$TURBO_ROOT$/packages/schemas/internal/notifications.yaml"
      ]
    }
  }
}
