# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
PORT=4001
LOG_LEVEL=debug
OIDC_ISSUER_URL=http://localhost:8080/realms/adili
DATABASE_URL=postgres://adili_directory:adili_directory_dev@localhost:55432/adili_directory
RABBITMQ_URL=amqp://adili:adili_dev@localhost:55672
VALKEY_URL=redis://localhost:56379
KEYCLOAK_CLIENT_ID=directory
KEYCLOAK_CLIENT_SECRET=directory-dev-secret
CONSOLE_URL=http://localhost:3020
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=adili
TEMPORAL_TASK_QUEUE=directory
DOCUMENTS_URL=http://localhost:4006
OTEL_SERVICE_NAME=directory
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
