# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
PORT=4005
LOG_LEVEL=debug
OIDC_ISSUER_URL=http://localhost:8080/realms/adili
DATABASE_URL=postgres://adili_reporting:adili_reporting_dev@localhost:55432/adili_reporting
RABBITMQ_URL=amqp://adili:adili_dev@localhost:55672
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=adili
TEMPORAL_TASK_QUEUE=reporting
DECLARATIONS_URL=http://localhost:4002
REVIEW_URL=http://localhost:4003
DIRECTORY_URL=http://localhost:4001
NOTIFICATIONS_URL=http://localhost:4010
DOCUMENTS_URL=http://localhost:4006
INTEGRATION_GATEWAY_URL=http://localhost:4009
AI_GATEWAY_URL=http://localhost:4008
# NCR pattern candidates (spec 09b); see config.ts for what each threshold means.
CANDIDATE_MIN_POINTS=0.02
CANDIDATE_RATE_CHANGE_FACTOR=2
CANDIDATE_MAX_NON_FILER_RATE=0.1
CANDIDATE_CHRONIC_LATE_YEARS=3
CANDIDATE_CLARIFICATION_RATIO_FACTOR=2
CANDIDATE_SIZE_BANDS=100,1000
CANDIDATE_SIZE_BAND_FACTOR=2
KEYCLOAK_CLIENT_ID=reporting
KEYCLOAK_CLIENT_SECRET=reporting-dev-secret
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=adili-dev-access
S3_SECRET_ACCESS_KEY=adili-dev-secret
S3_BUCKET_OPEN_DATA=open-data
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=adili-dev-root-token
OTEL_SERVICE_NAME=reporting
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
