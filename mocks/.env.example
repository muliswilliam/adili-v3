# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DATABASE_URL=postgres://mocks:mocks_dev@localhost:55432/mocks
LOG_LEVEL=info
# 07b adapter kit: leave empty in normal demos. Per-request overrides:
# X-Mock-Latency-Ms, X-Mock-Failure=timeout|unavailable|error
MOCK_IPRS_LATENCY_MS=0
MOCK_IPRS_FAILURE=
MOCK_SMS_LATENCY_MS=0
MOCK_SMS_FAILURE=
# Directory API the HR mock pushes roster batches to (spec 02 #54).
DIRECTORY_API_URL=http://localhost:4001
DIRECTORY_HR_TOKEN=demo-psc-roster-write
DIRECTORY_COMMISSION=psc
