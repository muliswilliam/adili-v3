# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DATABASE_URL=postgres://mocks:mocks_dev@localhost:55432/mocks
LOG_LEVEL=info
# 07b: pause a registry or tighten the per-minute limit.
MOCK_REGISTRY_RATE_LIMIT=60
MOCK_KRA_PAUSED=false
MOCK_NTSA_PAUSED=false
MOCK_BRS_PAUSED=false
MOCK_ARDHISASA_PAUSED=false
