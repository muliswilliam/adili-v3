# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DATABASE_URL=postgres://mocks:mocks_dev@localhost:55432/mocks
LOG_LEVEL=info
# 07b adapter kit: leave empty in normal demos. Per-request overrides:
# X-Mock-Latency-Ms, X-Mock-Failure=timeout|unavailable|error
MOCK_IPRS_LATENCY_MS=0
MOCK_IPRS_FAILURE=
MOCK_SMS_LATENCY_MS=0
MOCK_SMS_FAILURE=
# MOCK_<SYSTEM>_LATENCY_MS / MOCK_<SYSTEM>_FAILURE also work for KRA, NTSA, BRS, ARDHISASA.
# 07b: tighten the registry per-minute limit, or start a registry paused
# (POST /demo/registries/<system>/pause|resume changes it at runtime).
MOCK_REGISTRY_RATE_LIMIT=60
MOCK_KRA_PAUSED=false
MOCK_NTSA_PAUSED=false
MOCK_BRS_PAUSED=false
MOCK_ARDHISASA_PAUSED=false
# Directory API the HR mock pushes roster batches to (spec 02 #54), with the Commission's API
# credential: create it in the console (Roster, API access) and paste the client id and secret.
DIRECTORY_API_URL=http://localhost:4001
DIRECTORY_HR_TOKEN_URL=http://localhost:8080/realms/adili/protocol/openid-connect/token
DIRECTORY_HR_CLIENT_ID=
DIRECTORY_HR_CLIENT_SECRET=
DIRECTORY_COMMISSION=psc
