{
  "name": "@adili/keycloak-theme",
  "version": "0.0.0",
  "private": true,
  "description": "Keycloak login theme (Keycloakify) built on the Adili design system.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build-keycloak-theme": "pnpm build && keycloakify build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adili/ui": "workspace:*",
    "@hugeicons/core-free-icons": "^4.3.5",
    "keycloakify": "^11.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@adili/eslint-config": "workspace:*",
    "@adili/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
