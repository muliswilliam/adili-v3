# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
PORT=3010
APP_URL=http://localhost:3010
OIDC_ISSUER_URL=http://localhost:8080/realms/adili
OIDC_CLIENT_ID=portal
OIDC_CLIENT_SECRET=portal-dev-secret
VALKEY_URL=redis://localhost:56379
DIRECTORY_API_URL=http://localhost:4001
# Serve onboarding endpoints from fixtures until the directory implements spec 03 (#67).
# Dev server and tests only: production builds leave the mock out and ignore this.
DIRECTORY_MOCK=true
# Number of trusted proxies in front of the portal that append to X-Forwarded-For (default 1:
# the edge proxy, Traefik on Dokploy or the Kubernetes ingress). It must equal the real number
# of proxies: 0 behind a proxy makes every browser share one per-IP rate limit, and a value
# higher than the real number lets clients spoof their IP. Locally there is no proxy, so the
# header is absent and the socket address is used.
TRUSTED_PROXY_HOPS=1
DECLARATIONS_API_URL=http://localhost:4002
DOCUMENTS_API_URL=http://localhost:4006
# true serves the declarant's obligations from in-memory fixtures, to work on the portal without
# the declarations service. Dev server and tests only, like DIRECTORY_MOCK.
OBLIGATIONS_MOCK=true
# true serves declarations (drafts, submission, versions, amendments, acknowledgement slips) and
# uploads from in-memory fixtures, without the declarations and documents services. Works with
# real obligations (OBLIGATIONS_MOCK=false) too. Dev server and tests only, like DIRECTORY_MOCK.
DECLARATIONS_MOCK=true
# true serves Ask Adili (conversations, streamed answers, feedback) and help search from canned
# answers, without the assistant and the ai-gateway. Dev server and tests only, like DIRECTORY_MOCK.
ASSISTANT_MOCK=true
# The mock gateway's behaviour: ok, unavailable (help search), fail-midway or rate-limited.
ASSISTANT_MOCK_MODE=ok
# Rate Ask Adili answers: the mock answers ratings; the service builds them with #339.
ASSISTANT_FEEDBACK=true
REVIEW_API_URL=http://localhost:4003
# Serve clarifications from fixtures until the review service implements spec 07a (#174).
# Dev server and tests only, like DIRECTORY_MOCK. Needs DECLARATIONS_MOCK for attachments.
REVIEW_MOCK=true
ACCESS_API_URL=http://localhost:4004
# true serves the applicant's access requests (Form K, My requests, withdraw) and the Commissions
# open to them, and the declarant's access requests and representations, from in-memory fixtures,
# without the access service. Dev server and tests only, like DIRECTORY_MOCK. Pre-fill comes from
# the directory (DIRECTORY_MOCK for the demo applicant). Needs DECLARATIONS_MOCK for attachments.
ACCESS_MOCK=true
