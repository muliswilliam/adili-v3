# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
PORT=3010
APP_URL=http://localhost:3010
OIDC_ISSUER_URL=http://localhost:8080/realms/adili
OIDC_CLIENT_ID=portal
OIDC_CLIENT_SECRET=portal-dev-secret
VALKEY_URL=redis://localhost:56379
DIRECTORY_API_URL=http://localhost:4001
# Serve onboarding endpoints from fixtures until the directory implements spec 03 (#67).
# Dev server and tests only: production builds leave the mock out and ignore this.
DIRECTORY_MOCK=true
# Number of trusted proxies in front of the portal that append to X-Forwarded-For (default 1:
# the edge proxy, Traefik on Dokploy or the Kubernetes ingress). It must equal the real number
# of proxies: 0 behind a proxy makes every browser share one per-IP rate limit, and a value
# higher than the real number lets clients spoof their IP. Locally there is no proxy, so the
# header is absent and the socket address is used.
TRUSTED_PROXY_HOPS=1
DECLARATIONS_API_URL=http://localhost:4002
DOCUMENTS_API_URL=http://localhost:4006
# The public verify app; the QR on an acknowledgement slip opens <this>/v/<code>. Same value as
# the documents service's VERIFY_BASE_URL.
VERIFY_BASE_URL=http://localhost:3030
# true serves the declarant's obligations from in-memory fixtures, to work on the portal without
# the declarations service. Dev server and tests only, like DIRECTORY_MOCK.
OBLIGATIONS_MOCK=true
# true serves declaration drafts and uploads from in-memory fixtures until the services implement
# spec 05 (#115). Works with real obligations (OBLIGATIONS_MOCK=false) too. Dev server and tests
# only, like DIRECTORY_MOCK.
DECLARATIONS_DRAFTS_MOCK=true
REVIEW_API_URL=http://localhost:4003
# Serve clarifications from fixtures until the review service implements spec 07a (#174).
# Dev server and tests only, like DIRECTORY_MOCK. Needs DECLARATIONS_DRAFTS_MOCK for attachments.
REVIEW_MOCK=true
