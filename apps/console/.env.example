# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
PORT=3020
APP_URL=http://localhost:3020
OIDC_ISSUER_URL=http://localhost:8080/realms/adili
OIDC_CLIENT_ID=console
OIDC_CLIENT_SECRET=console-dev-secret
VALKEY_URL=redis://localhost:56379
DIRECTORY_API_URL=http://localhost:4001
REVIEW_API_URL=http://localhost:4003
DOCUMENTS_API_URL=http://localhost:4006
DECLARATIONS_API_URL=http://localhost:4002
INTEGRATION_GATEWAY_API_URL=http://localhost:4009
ACCESS_API_URL=http://localhost:4004
REPORTING_API_URL=http://localhost:4005
AI_GATEWAY_API_URL=http://localhost:4008
# Public API base URL shown to Commissions' IT teams (roster API documentation).
PUBLIC_API_URL=http://localhost:4001
# The portal, for links to its public pages (open data).
PORTAL_URL=http://localhost:3010
# The verify app, for an open-data release manifest's verify page and QR code.
VERIFY_URL=http://localhost:3030
# Serve review clarifications from fixtures until the review service implements spec 07a (#174).
# Dev server and tests only: production builds leave the mock out and ignore this.
REVIEW_MOCK=true
# Serve access requests (spec 10) from in-memory fixtures instead of the access service.
# Dev server and tests only: production builds leave the mock out and ignore this.
ACCESS_MOCK=true
# Serve Form M, EACC's intake totals, the referrals intake and the national report (spec 09) from in-memory fixtures instead of the reporting service.
# Dev server and tests only: production builds leave the mock out and ignore this.
REPORTING_MOCK=true
# With REPORTING_MOCK: the day the mock takes as today (YYYY-MM-DD), e.g. 2027-04-10 for the preview window.
# REPORTING_MOCK_TODAY=2027-04-10
# With REVIEW_MOCK: `not-enabled` shows every mock case's copilot as not enabled (default `ready`).
REVIEW_MOCK_COPILOT=ready
# Serve AI policy, routing and usage from fixtures, so the console runs without the ai-gateway.
# Dev server and tests only: production builds leave the mock out and ignore this.
AI_GATEWAY_MOCK=true
# With REPORTING_MOCK: FY 2025/2026's report starts `not-built`, `draft`, `stale` or `approved`.
REPORTING_MOCK_NCR=not-built
# With REPORTING_MOCK: EACC's open-data releases `history` (default), `none`, `unavailable`, `reconciliation-failed` or `documents-unavailable` (publish and withdraw 503).
# REPORTING_MOCK_RELEASES=history
# With REPORTING_MOCK: the report's pattern candidates are `computed`, `none` or `error`.
REPORTING_MOCK_CANDIDATES=computed
# With REPORTING_MOCK: AI narrative drafts are `inserted`, `slow` (202, then inserted), `validation`,
# `slow-validation`, `failed` (502) or `unavailable` (503).
REPORTING_MOCK_NARRATIVE=inserted
# Serve help articles, the legal corpus and question themes (spec 11) from in-memory fixtures.
# Dev server and tests only: production builds leave the mock out and ignore this.
HELP_MOCK=true
