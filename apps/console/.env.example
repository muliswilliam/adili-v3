# Local development defaults (see infra/compose). Copied to .env by `pnpm bootstrap`.
PORT=3020
APP_URL=http://localhost:3020
OIDC_ISSUER_URL=http://localhost:8080/realms/adili
OIDC_CLIENT_ID=console
OIDC_CLIENT_SECRET=console-dev-secret
VALKEY_URL=redis://localhost:56379
DIRECTORY_API_URL=http://localhost:4001
# Dev only: set to true to serve the directory's Commission endpoints from MSW fixtures
# (src/mocks) until the directory implements spec 01 (#13). Ignored by production builds.
DIRECTORY_MOCK=false
