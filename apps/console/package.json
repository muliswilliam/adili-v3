{
  "name": "@adili/console",
  "version": "0.0.0",
  "private": true,
  "description": "Console for Commissions, employers and EACC (TanStack Start BFF).",
  "type": "module",
  "scripts": {
    "generate:api": "openapi-typescript node_modules/@adili/schemas/internal/directory.yaml -o src/server/directory/api.gen.ts && openapi-typescript node_modules/@adili/schemas/internal/documents.yaml -o src/server/documents/api.gen.ts && openapi-typescript node_modules/@adili/schemas/internal/declarations.yaml -o src/server/declarations/api.gen.ts",
    "dev": "pnpm generate:api && node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
    "build": "pnpm generate:api && vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm generate:api && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adili/bff-auth": "workspace:*",
    "@adili/roles": "workspace:*",
    "@adili/ui": "workspace:*",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@adili/eslint-config": "workspace:*",
    "@adili/schemas": "workspace:*",
    "@adili/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "nitro": "3.0.260903-beta",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
