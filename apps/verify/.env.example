# Local development defaults. Copied to .env by `pnpm bootstrap`.
# Public verification does not sign in today. The Keycloak `verify` client
# (secret verify-dev-secret, http://localhost:3030) is reserved for a later BFF.
PORT=3030
VERIFICATION_API_URL=http://localhost:4007
# true answers lookups from in-memory fixtures (src/server/verification/mock.server.ts lists the
# codes, one per result state). Dev server and tests only: production builds leave it out.
VERIFICATION_MOCK=false
# Number of trusted proxies in front of the verify app that append to X-Forwarded-For (default 1:
# the edge proxy). The browser's address is sent on for verification-api's per-IP rate limit.
TRUSTED_PROXY_HOPS=1
